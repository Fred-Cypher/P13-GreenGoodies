{% extends 'base.html.twig' %}

{% block title %}Green Goodies - Accueil{% endblock %}

{% block body %}
    <div class="heroHeader">
        <div class="col-6 m-auto ">
            <div class="welcome m-auto">
                <div class="welcomeTitle">Bienvenue</div>
                <div class="mt-5">
                    <p class="welcomeText">
                        Découvrez notre univers de produits durables et éthiques pour une consommation responsable
                    </p>
                    <p class="welcomeText">
                        Retrouvez des articles d’hygiène & beauté, des accessoires & boissons et du prêt à porter
                    </p>
                </div>
            </div>
        </div>
        <div class="col-6 justify-content-end">
            <img src="{{ asset('assets/images/home.webp') }}" alt="" class="homeImg">
        </div>
    </div>
    <div class="homeProductsTitle">NOS PRODUITS</div>
    <div class="homeProducts col-12 flex-wrap">
            {% for product in products %}
                    <div class="card text-center col-4 m-auto">
                        <div class="homeCardPicture">
                            <img src=" {{ asset('assets/images/' ~ product.picture ) }}" class="card-img-top img-fluid" alt="{{ product.name }}">
                        </div>
                        <div class="card-body">
                            <p class="card-title">{{ product.name }}</p>
                            <p class="card-text">{{ product.shortDescription }}</p>
                            <p class="card-price">{{ product.price }}€ </p>
                            <a href="#" class="">Voir le produit</a>
                        </div>
                    </div>
            {% endfor %}
    </div>
{% endblock %}
