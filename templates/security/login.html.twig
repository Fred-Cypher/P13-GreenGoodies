{% extends 'base.html.twig' %}

{% block title %}GreenGoodies - Connexion{% endblock %}

{% block body %}
    <main>
        <div class="row col-12 g-0">
            <div class="col-12 col-md-6">
                <img src="{{ asset('assets/images/flowers.webp') }}" alt="Branche fleurie" class="w-100">
            </div>
            <div class="col-12 col-md-6 mt-5">
                <div class="col-10 col-md-6 p-2 m-auto">
                    <form action="{{ path('app_login') }}" method="post">
                        {% if error %}
                            <div
                                class="alert alert-danger">{{ error.messageKey == 'Invalid credentials.' ? 'Identifiants incorrects.' : error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <div class="h3 mt-5 col-12">Connexion</div>
                        <div class="mt-5">
                            <label for="username">Adresse email</label>
                            <input type="email" value="{{ email }}" name="_username" id="username"
                                   class="form-control-lg border mt-3 col-12" autocomplete="email" required autofocus>
                        </div>
                        <div class="mt-3">
                            <label for="password">Mot de passe</label>
                            <input type="password" name="_password" id="password"
                                   class="form-control-lg border mt-3 col-12" autocomplete="current-password" required>
                        </div>
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                               value="{{ csrf_token('authenticate') }}">

                        <div class="mt-2">
                            <button class="btn btn-dark mt-4 p-3 w-100" type="submit">
                                Se connecter
                            </button>
                        </div>

                        <p class="mt-3 text-center">
                            <a href="{{ path('app_register') }}" class="linkColor text-decoration-underline">Pas encore
                                de compte ? S'inscrire</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
