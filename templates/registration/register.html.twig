{% extends 'base.html.twig' %}

{% block title %}GreenGoodies - Inscription{% endblock %}

{% block body %}
    <div class="register">
        <div class="col-6">
            <img src="{{ asset('assets/images/foliage.webp') }}" alt="" class="registerImg">
        </div>
        <div class="col-6">
            <div class="col-6 p-2 m-auto">
                <div class="h3 mt-5">Inscription</div>
                <div class="mt-4">Tous les champs sont obligatoires</div>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                <div class="mt-2">
                    {{ form_row(registrationForm.lastName) }}
                </div>
                <div class="mt-2">
                    {{ form_row(registrationForm.firstName) }}
                </div>
                <div class="mt-2">
                    {{ form_row(registrationForm.email) }}
                </div>
                <div class="mt-2">
                    {{ form_row(registrationForm.password) }}
                </div>
                <div class="mt-2">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
                <button type="submit" class="btn button mt-3">S'inscrire</button>
                {{ form_end(registrationForm) }}
                <div class="mt-3 text-center">
                    <a href="{{ path('app_login') }}" class="questionLink">Déjà un compte ? Se connecter</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
